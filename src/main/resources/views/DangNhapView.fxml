<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane alignment="CENTER" minHeight="500.0" minWidth="500.0" prefHeight="680.0" prefWidth="1080.0"
           styleClass="login-page" stylesheets="@../css/app.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controllers.DangNhapController">
    <children>
        <Circle mouseTransparent="true" radius="150.0" styleClass="login-orb-blue" StackPane.alignment="TOP_LEFT">
            <StackPane.margin>
                <Insets left="120.0" top="80.0" />
            </StackPane.margin>
        </Circle>
        <Circle mouseTransparent="true" radius="205.0" styleClass="login-orb-violet" StackPane.alignment="BOTTOM_RIGHT">
            <StackPane.margin>
                <Insets bottom="50.0" right="145.0" />
            </StackPane.margin>
        </Circle>
        <VBox maxWidth="410.0" spacing="0.0" styleClass="login-card" StackPane.alignment="CENTER">
            <padding>
                <Insets bottom="38.0" left="40.0" right="40.0" top="38.0" />
            </padding>
            <children>
                <Label styleClass="form-title" text="Đăng nhập" />

                <Label styleClass="field-label" text="Email">
                    <VBox.margin>
                        <Insets top="28.0" />
                    </VBox.margin>
                </Label>
                <TextField fx:id="txtDiaChiEmail" maxWidth="Infinity" prefHeight="50.0"
                           promptText="Email" styleClass="form-field" />

                <Label styleClass="field-label" text="Mật khẩu">
                    <VBox.margin>
                        <Insets top="19.0" />
                    </VBox.margin>
                </Label>
                <PasswordField fx:id="txtMatKhau" maxWidth="Infinity" onAction="#onAnNutDangNhap"
                               prefHeight="50.0" promptText="Mật khẩu" styleClass="form-field" />

                <Label fx:id="lblLoi" managed="false" styleClass="form-error"
                       text="Email hoặc mật khẩu không chính xác" visible="false" wrapText="true" />

                <Button maxWidth="Infinity" onAction="#onAnNutDangNhap"
                        prefHeight="52.0" styleClass="login-button" text="Đăng nhập">
                    <VBox.margin>
                        <Insets top="26.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </children>
</StackPane>
